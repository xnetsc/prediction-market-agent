# 通用运行时配置。插件 URL、代理、凭证、策略和风险值不属于本文件；程序不存在执行模式切换。
PLUGIN_SDK_CONFIG_FILE=src/prediction_market_agent/config/plugin_sdk.default.json
BOT_MANAGEMENT_FILE=bot_management.json

# 仅当 BOT_MANAGEMENT_FILE 没有保存相应类别时使用的首次回退名单。
MARKET_API_PLUGINS=binance,polymarket
DECISION_PROVIDERS=codex,claude,openai_compatible
RESEARCH_TOOL_PLUGINS=standard_research
RISK_PLUGINS=portfolio_limits,agent_actions,dynamic_python
HOOK_PLUGINS=

# 通用调度、状态、会话窗口。
PREDICTION_AGENT_MAX_TOPICS_PER_CYCLE=10
PREDICTION_AGENT_MAX_DECISIONS_PER_CYCLE=6
PREDICTION_AGENT_INTERVAL_SECONDS=60
PREDICTION_AGENT_RUN_UNTIL_EPOCH=0
PREDICTION_AGENT_STATE_FILE=agent_state.json
PREDICTION_AGENT_SESSION_DB=agent_sessions.sqlite3
AGENT_MAX_TOOL_STEPS=4
AGENT_TOOL_RESULT_CHARS=12000
CONTEXT_WINDOW_CHARS=60000
HISTORY_PER_MARKET=12

# 本机审计与插件管理界面。
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_REFRESH_SECONDS=5
